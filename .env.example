# Copy this to .env.local and fill in your values

# Claude API (get from platform.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Stripe (get from stripe.com dashboard)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PRICE_MONTHLY=price_your_monthly_price_id
STRIPE_PRICE_YEARLY=price_your_yearly_price_id

# Supabase (get from supabase.com project settings)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# App URL (your Vercel deployment URL)
APP_URL=https://fintonomy.vercel.app
